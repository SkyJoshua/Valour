@using Valour.Sdk.ModelLogic.QueryEngines
@inject ValourClient Client
@inject StaffService StaffService

@if (_selectedIds.Count > 0)
{
    <div class="bulk-actions">
        <span class="bulk-actions-count">@_selectedIds.Count selected</span>
        <div class="bulk-actions-buttons">
            <button class="v-btn secondary" @onclick="@(() => BulkSetDisabled(true))">Disable Selected</button>
            <button class="v-btn primary" @onclick="@(() => BulkSetDisabled(false))">Enable Selected</button>
            <button class="v-btn danger" @onclick="@BulkDeleteSelected">Delete Selected</button>
            <button class="v-btn" @onclick="@(() => _selectedIds.Clear())">Clear Selection</button>
        </div>
    </div>
}

<QueryTable
    @ref="@_table"
    Columns="@_columns"
    Engine="@_engine"
    ShowSearch="@true"
    SearchPlaceholder="Search name..."
    Infinite="@true"
/>

@code {
    [CascadingParameter]
    public ModalRoot ModalRoot { get; set; }

    private QueryTable<User> _table;

    private List<ColumnDefinition<User>> _columns;

    private string _nameSearch = string.Empty;

    private StaffUserQueryEngine _engine;

    private readonly HashSet<long> _selectedIds = new();

    protected override void OnInitialized()
    {
        _engine = new StaffUserQueryEngine(Client.PrimaryNode);

        _columns = new()
        {
            new ()
            {
                Name = "",
                Width = "76px",
                RenderFragment = (rowData) =>
                    @<label class="switch">
                        <input type="checkbox"
                               checked="@_selectedIds.Contains(rowData.Row.Id)"
                               @onchange="@(e => ToggleSelected(rowData.Row.Id, (bool)e.Value!))" />
                        <span class="slider round"></span>
                    </label>
            },
            new ()
            {
                Name = "Card",
                RenderFragment = (rowData) =>
                    @<UserInfoComponent User="@rowData.Row" ShowBadges="false" ShowState="false" />
            },
            new ()
            {
                Name = "Name",
                RenderFragment = (rowData) =>
                    @<span>@rowData.Row.NameAndTag</span>
            },
            new ()
            {
                Name = "Actions",
                RenderFragment = (rowData) =>
                    @<div class="button-row">
                        @if (rowData.Row.Disabled)
                        {
                            <button class="v-btn primary" @onclick="@(async () => await EnableUser(rowData.Row.Id))">Enable</button>
                        }
                        else
                        {
                            <button class="v-btn secondary" @onclick="@(async () => await DisableUser(rowData.Row.Id))">Disable</button>
                        }

                        <button class="v-btn danger" @onclick="@(async () => await DeleteUser(rowData.Row))">Delete</button>
                    </div>
            }
        };
    }

    private void ToggleSelected(long userId, bool isSelected)
    {
        if (isSelected)
            _selectedIds.Add(userId);
        else
            _selectedIds.Remove(userId);
    }
    
    /* Staff Controls */
    
    public async Task DisableUser(long userId)
    {
        var toastData = new ProgressToastData<TaskResult>()
        {
            Title = "Disabling User",
            SuccessMessage = "User has been disabled",
            Message = "Waiting for result...",
            ProgressTask = StaffService.SetUserDisabledAsync(userId, true)
        };
        
        var result = await ToastContainer.Instance.WaitToastWithTaskResult(toastData);

        if (result.Success)
        {
            await _table.Requery();
        }
    }
    
    private async Task EnableUser(long userId)
    {
        var toastData = new ProgressToastData<TaskResult>()
        {
            Title = "Enabling User",
            SuccessMessage = "User has been enabled",
            Message = "Waiting for result...",
            ProgressTask = StaffService.SetUserDisabledAsync(userId, false)
        };
        
        var result = await ToastContainer.Instance.WaitToastWithTaskResult(toastData);

        if (result.Success)
        {
            await _table.Requery();
        }
    }
    
    public Task DeleteUser(User user)
    {
        ModalRoot.OpenModal<ConfirmModalComponent>(new ConfirmModalComponent.ModalParams()
        {
            Title = $"Hard Delete {user.NameAndTag}?",
            Description = "This CANNOT be undone. Are you sure you want to delete this user?",
            CancelText = "Cancel",
            ConfirmText = "DELETE",
            ConfirmEvent = async () =>
            {
                var toastData = new ProgressToastData<TaskResult>()
                {
                    Title = "Deleting User",
                    SuccessMessage = "User has been deleted",
                    Message = "Waiting for result...",
                    ProgressTask = StaffService.DeleteUserAsync(user.Id)
                };

                var result = await ToastContainer.Instance.WaitToastWithTaskResult(toastData);

                if (result.Success)
                {
                    await _table.Requery();
                }
            }
        });

        return Task.CompletedTask;
    }

    private async Task BulkSetDisabled(bool value)
    {
        var ids = _selectedIds.ToArray();

        var toastData = new ProgressToastData<TaskResult<BulkActionResult>>()
        {
            Title = value ? "Disabling Users" : "Enabling Users",
            SuccessMessage = "Bulk action complete",
            Message = $"Updating {ids.Length} users...",
            ProgressTask = StaffService.BulkSetUsersDisabledAsync(ids, value)
        };

        var result = await ToastContainer.Instance.WaitToastWithTaskResult(toastData);

        if (result.Success)
        {
            _selectedIds.Clear();
            await _table.Requery();
            ReportBulkFailures(result.Data);
        }
    }

    private Task BulkDeleteSelected()
    {
        var ids = _selectedIds.ToArray();

        ModalRoot.OpenModal<ConfirmModalComponent>(new ConfirmModalComponent.ModalParams()
        {
            Title = $"Hard Delete {ids.Length} Users?",
            Description = "This CANNOT be undone. Are you sure you want to delete all selected users?",
            CancelText = "Cancel",
            ConfirmText = "DELETE",
            ConfirmEvent = async () =>
            {
                var toastData = new ProgressToastData<TaskResult<BulkActionResult>>()
                {
                    Title = "Deleting Users",
                    SuccessMessage = "Bulk delete complete",
                    Message = $"Deleting {ids.Length} users...",
                    ProgressTask = StaffService.BulkDeleteUsersAsync(ids)
                };

                var result = await ToastContainer.Instance.WaitToastWithTaskResult(toastData);

                if (result.Success)
                {
                    _selectedIds.Clear();
                    await _table.Requery();
                    ReportBulkFailures(result.Data);
                }
            }
        });

        return Task.CompletedTask;
    }

    private static void ReportBulkFailures(BulkActionResult data)
    {
        if (data?.Failures is not { Count: > 0 })
            return;

        var reasons = string.Join("; ", data.Failures.Select(f => $"{f.UserId}: {f.Message}"));
        ToastContainer.Instance.AddToast(new ToastData()
        {
            Title = $"{data.Failures.Count} user(s) failed",
            Message = reasons
        });
    }
}